# Environment Configuration Template
# Copy this to .env and fill in your values
# DO NOT commit .env to git (add to .gitignore)

# Django Settings
ENVIRONMENT=production
DEBUG=False
SECRET_KEY=your-secret-key-here-generate-with-django-secret-key-generator
ALLOWED_HOSTS=localhost,127.0.0.1,example.com

# Database (Railway/PostgreSQL)
# Preferred on Railway:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sentinel_db

# Optional fallback when DATABASE_URL is not set
DB_ENGINE=postgres
POSTGRES_DB=sentinel_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SSLMODE=prefer
POSTGRES_CONN_MAX_AGE=60

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
USE_REDIS_CHANNEL_LAYER=False

# API Keys & External Services
OPENROUTER_API_KEY=your-openrouter-api-key-here

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000
CSRF_TRUSTED_ORIGINS=https://example.com,https://your-app.up.railway.app

# Email Configuration (for notifications)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# Security Settings
USE_X_FORWARDED_HOST=True
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# Feature Flags
ENABLE_WEBSOCKETS=True
ENABLE_AI_ANALYSIS=True
ENABLE_AUDIT_LOGGING=True

# Logging Level
LOG_LEVEL=INFO
